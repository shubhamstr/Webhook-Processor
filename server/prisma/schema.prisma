datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @unique @map("event_id") @db.VarChar(255)
  eventType      String    @map("event_type") @db.VarChar(255)
  payload        Json      @db.JsonB
  status         String    @default("pending") @db.VarChar(50)
  totalAttempts  Int       @default(0) @map("total_attempts")
  cycleAttempts  Int       @default(0) @map("cycle_attempts")
  maxAttempts    Int       @default(5) @map("max_attempts")
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz
  leaseOwner     String?   @map("lease_owner") @db.VarChar(255)
  leaseToken     String?   @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz
  lastError      String?   @map("last_error") @db.Text
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  processingAttempts ProcessingAttempt[]
  processedOrder     ProcessedOrder?

  @@index([status, nextAttemptAt])
  @@index([leaseOwner, leaseExpiresAt])
  @@map("webhook_events")
}

model ProcessingAttempt {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  attemptNumber Int       @map("attempt_number")
  retryCycle    Int       @default(1) @map("retry_cycle")
  workerId      String    @map("worker_id") @db.VarChar(255)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  result        String?   @map("result") @db.VarChar(50)
  error         String?   @map("error") @db.Text

  webhookEvent WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([workerId])
  @@map("processing_attempts")
}

model ProcessedOrder {
  orderId     String   @map("order_id") @db.VarChar(255)
  eventId     String   @id @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  webhookEvent WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("processed_orders")
}
