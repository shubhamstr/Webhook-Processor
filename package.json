{
  "name": "webhook-processor",
  "version": "1.0.0",
  "description": "High-performance idempotent Webhook Processor with NestJS backend, Next.js frontend, PostgreSQL, and concurrent background workers.",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:studio": "docker compose --profile studio up -d studio",
    "docker:studio:down": "docker compose stop studio",
    "test:burst": "npm --prefix server run test:burst",
    "test:burst:slow": "npm --prefix server run test:burst:slow"
  },
  "keywords": [
    "webhook",
    "nestjs",
    "nextjs",
    "postgres",
    "prisma",
    "docker",
    "docker-compose"
  ],
  "author": "",
  "license": "UNLICENSED"
}
